# SujudSense environment template
# Copy this file to .env and customize as needed.

# Embedding and vector store settings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=10
FINAL_K=3
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_HYBRID=false
HYBRID_BM25_WEIGHT=0.5
HYBRID_DENSE_WEIGHT=0.5

# LLM settings
FAST_LLM_MODEL=llama-3.1-8b-instant
FAST_LLM_MODEL_MAX_TOKENS=256
HEAVY_LLM_MODEL=llama-3.3-70b-versatile
HEAVY_LLM_TEMPERATURE=0.1
HEAVY_LLM_MAX_TOKENS=512

# Cloud LLM provider token
GROQ_API_KEY=

# Query safety firewall threshold
FIREWALL_THRESHOLD=1

# Logger settings
LOG_LEVEL=INFO
